# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored by default.

# Supabase — get these from Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: keep secret, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Plain string used as the admin cookie value at /admin
ADMIN_PASSWORD=
